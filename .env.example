# Copy to .env and edit.

# Sensor hostname or IP. Leave empty to type it in the UI instead.
# Prefer the IP: ".local" (mDNS) names often fail in containers.
OUSTER_SOURCE=

# Web UI port
PORT=8080

# --- Advanced (only if the default auto-configuration does not work in your network) ---
# Seconds to wait for lidar packets before treating the stream as dead
# OUSTER_TIMEOUT=5
# Fixed UDP destination ports (0 = SDK default)
# OUSTER_LIDAR_PORT=7502
# OUSTER_IMU_PORT=7503
# You configured udp_dest on the sensor yourself - don't let the SDK change it
# OUSTER_NO_AUTO_UDP_DEST=1
# Never reinitialize the sensor
# OUSTER_NO_REINIT=1
# Tolerate init_id / serial mismatch after a sensor reboot
# OUSTER_SOFT_ID_CHECK=1
